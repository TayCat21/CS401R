# Claude gave me this template to scrape Bluesky API and put in Excel

"""
Collect recent posts from a list of Bluesky accounts and append new ones
to an Excel file (posts.xlsx). Posts already in the file are skipped (by post ID).

Setup:  pip install requests openpyxl
Run:    python bluesky_collector.py
"""
import os
from datetime import datetime, timezone

import requests
from openpyxl import Workbook, load_workbook

API = "https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed"
OUTFILE = "posts.xlsx"
COLUMNS = ["collected_at", "account", "post_id", "post_time",
           "text", "likes", "reposts", "replies"]

# Replace with your 122 handles (or load them from a text/CSV file)
ACCOUNTS = ["ABR.nws-bot.us"]


def fetch_posts(handle, limit=50):
    """Return the account's latest posts as a list of row dicts."""
    resp = requests.get(API, params={"actor": handle, "limit": limit}, timeout=30)
    resp.raise_for_status()
    now = datetime.now(timezone.utc).isoformat(timespec="seconds")
    rows = []
    for item in resp.json().get("feed", []):
        post = item["post"]
        if post["author"]["handle"] != handle:  # skip reposts of other accounts
            continue
        rows.append({
            "collected_at": now,
            "account": handle,
            "post_id": post["uri"],
            "post_time": post["record"].get("createdAt", ""),
            "text": post["record"].get("text", ""),
            "likes": post.get("likeCount", 0),
            "reposts": post.get("repostCount", 0),
            "replies": post.get("replyCount", 0),
        })
    return rows


def load_or_create(path):
    """Open the workbook, or create it with a header row."""
    if os.path.exists(path):
        wb = load_workbook(path)
        ws = wb.active
    else:
        wb = Workbook()
        ws = wb.active
        ws.title = "posts"
        ws.append(COLUMNS)
    return wb, ws


def main():
    wb, ws = load_or_create(OUTFILE)
    seen = {row[2] for row in ws.iter_rows(min_row=2, values_only=True)}  # post_id column

    added = 0
    for handle in ACCOUNTS:
        try:
            for row in fetch_posts(handle):
                if row["post_id"] in seen:
                    continue
                ws.append([row[c] for c in COLUMNS])
                seen.add(row["post_id"])
                added += 1
        except requests.RequestException as e:
            print(f"Skipping {handle}: {e}")  # one bad account shouldn't stop the run

    wb.save(OUTFILE)
    print(f"Added {added} new posts. Total rows: {ws.max_row - 1}")


if __name__ == "__main__":
    main()
